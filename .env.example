# SuperTale / NovelVideo newAPI environment variable example
#
# Copy to .env and fill in real values.
# On the SuperTale side, configure only the newAPI gateway, newAPI logical model names, the reference-media relay and runtime parameters.
# Upstream channels, real models, mappings, prices and token permissions are configured in the newAPI admin console.


# =============================================================================
# 0. Task envelope signing (optional; leave empty for single-host deployments)
# =============================================================================

# Task envelopes are HMAC-signed so a task's identity cannot be rewritten in transit. Single-host deployments need no configuration:
# a local key is generated on first start and stored at <NOVELVIDEO_STATE_DIR>/task_envelope_keyring.json
# (mode 0600) and reused on later restarts.
#
# Configure it explicitly only when several hosts run the same set of tasks - then all processes must use the same keyring,
# otherwise what one side signs the other cannot verify. To generate a key:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# The active key ID must match ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ and exist in the keyring;
# the keyring may keep retired keys for verification during a rotation window. Keep real values only on the local machine or in a secret manager.
ST_TASK_ENVELOPE_ACTIVE_KEY_ID=
ST_TASK_ENVELOPE_KEYRING_B64_JSON=


# =============================================================================
# 1. newAPI unified gateway
# =============================================================================

# Host port of the bundled newapi admin console (docker compose only). The container port is fixed at 3000; only the host mapping changes here.
# Defaults to 3000; change it (for example to 30000) on a port conflict.
# ST_NEWAPI_PORT=3000

# Image source and version (image mode docker-compose.release.yml only). Pulls pinned claymorelab/* versions from Docker Hub by default
# (see the defaults in the file; bumped by a PR opened by the packaging workflow after each release, not latest).
# If pulling is slow in some regions, switch to the Alibaba Cloud ACR public registry; ACR only has the tags pinned by releases, no latest, and all three lines must be filled together:
# DRAMACLAW_IMAGE_PREFIX=claymore-registry.cn-chengdu.cr.aliyuncs.com/dramaclaw
# DRAMACLAW_VERSION=2.0.2
# DRAMACLAW_GATEWAY_VERSION=v1.0.0-rc.24-dramaclaw.1
# The gateway admin port binds to loopback only by default; open it up when you need to reach the gateway admin from another machine:
# ST_NEWAPI_BIND=0.0.0.0
# Source builds (docker compose up -d --build) build the gateway from the ../dramaclaw-gateway checkout next to this repo by default (git clone it first);
# change this if the clone lives elsewhere, or if you would rather let Docker pull straight from git:
# DRAMACLAW_GATEWAY_SRC=../dramaclaw-gateway
# DRAMACLAW_GATEWAY_SRC=https://github.com/dramaclaw/dramaclaw-gateway.git#main

# For the official channel, enter the DC key in the web UI under Settings > Model configuration > Official channel.
# The local channel uses the NewAPI bundled with CE, and the setup wizard creates the runtime token automatically.
# The runtime address and token of both channels are stored in the local settings.db, not read from environment variables.

# CE local NewAPI setup wizard. The database is always local SQLite; no DSN or path is needed.
NEWAPI_PROVISIONER_ENABLED=true

# NewAPI admin address, without /v1; used for the /api/channel/ and /api/token/ management APIs.
NEWAPI_ADMIN_BASE_URL=http://127.0.0.1:3000

NEWAPI_PROVISIONER_INIT_TIMEOUT_MS=120000
NEWAPI_RELAY_TOKEN_NAME=dramaclaw-ce-runtime

# Whether the newAPI text-model client reads the system proxy. Defaults to true.
# Set to false if a local Surge system proxy interferes with the intranet newAPI.
# NEWAPI_TEXT_TRUST_ENV=false

# newAPI text-model HTTP timeout, in seconds.
NEWAPI_TEXT_TIMEOUT_SECONDS=300

# The official catalog is read from the dramaclaw-dl OSS by default; content files use immutable SHA256 paths.
# OFFICIAL_MEDIA_CATALOG_MANIFEST_URL=https://dramaclaw-dl.oss-cn-chengdu.aliyuncs.com/official-media-catalog/manifest.json
# Backend auto-update polling interval, minimum 60 seconds, default 300 seconds.
# OFFICIAL_MEDIA_CATALOG_POLL_SECONDS=300
# Legacy-deployment compatibility: an address that returns the catalog JSON directly. Used only when no manifest is configured.
# Defaults to reading the catalog file from the main branch of the DramaClaw GitHub repo.
# OFFICIAL_MEDIA_CATALOG_URL=https://raw.githubusercontent.com/dramaclaw/dramaclaw/main/src/novelvideo/official_media_models.json

# Hermes / Shrimp Director chat model. The address and key always follow the currently selected model gateway.
HERMES_MODEL=DC-hermes-LLM
HERMES_MODEL_API_MODE=chat_completions
HERMES_MODEL_CONTEXT_LENGTH=131072
# Freezone defaults to progressive tool disclosure. Set "off" only as a
# compatibility rollback; "on" forces the same bridge behavior as "auto".
HERMES_TOOL_SEARCH_MODE=auto

# Running Hermes from source on Linux: chat is refused by default when the sandbox is missing, unavailable or inactive.
# Single-host local development only: uncomment the next line after you accept running without a sandbox; a warning is still logged at runtime.
# This switch cannot bypass the sandbox requirement of EE (non-empty ST_CONTROL_PLANE_DSN) or production environments.
# Codex does not use this Hermes switch. See docs/en/getting-started/installation.md for configuration.
# SUPERTALE_ALLOW_UNSANDBOXED=1

# CE turns the Shrimp Director entry off by default; enable it explicitly to test the outer Shrimp Director and the in-canvas Shrimp Director locally.
# ST_CE_ENABLE_ASSISTANT_SURFACES=true

# Codex / Shrimp Director chat model. It also goes through the currently selected NewAPI model gateway; the gateway routes
# DC-codex-agent-LLM to the actual upstream model. The CE Docker image with the security-patched Runtime
# uses the Codex App Server by default; the source startup script uses its installed Hermes by default. To use
# Codex from source, set both DRAMACLAW_CHAT_BACKEND=codex and a valid CODEX_BIN.
CODEX_MODEL=DC-codex-agent-LLM
# The full Codex model catalog ships with the repo and the image. Override it with an absolute path only when the Gateway alias
# capabilities differ.
# DRAMACLAW_CODEX_MODEL_CATALOG_FILE=/app/deploy/codex/dramaclaw-model-catalog.json
# The Codex Agent enables medium reasoning by default. If the model actually routed by NewAPI requires another level, set
# none/minimal/low/medium/high/xhigh/max/ultra; do not set none for reasoning models.
CODEX_REASONING_EFFORT=medium
# The Codex App Server shares one process per home node; when unset it uses
# NOVELVIDEO_STATE_DIR/.codex-app-server, and each project stores only its own thread mapping and workspace.
# DRAMACLAW_CODEX_HOME=/data/state/.codex-app-server

# Local development only: lets a loopback-connected Agent use this session's owner identity when it has no Token.
# Never enable this in any deployment reachable from outside or behind a reverse proxy.
# DRAMACLAW_LOCAL_AGENT_TRUST=true


# =============================================================================
# 2. newAPI reference-media OSS relay
# =============================================================================

# Local reference images must first be uploaded to the OSS relay, and a short-lived signed URL is then passed to newAPI/upstream.
# Once the CE frontend saves the OSS relay configuration, the local SQLite configuration takes precedence.
MEDIA_RELAY_PROVIDER=aliyun_oss

# Default validity of signed URLs, in seconds. Once saved in the CE frontend, the local SQLite configuration takes precedence.
MEDIA_RELAY_TTL_SECONDS=1800

# The relay bucket is dedicated to newAPI reference media. Once saved in the CE frontend, the local SQLite configuration takes precedence.
OSS_RELAY_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_RELAY_BUCKET=claymore-llm-relay
OSS_RELAY_AK=
OSS_RELAY_SK=

# Optional: use Cloudinary as the reference-media relay. Takes effect after setting MEDIA_RELAY_PROVIDER to cloudinary.
CLOUDINARY_RELAY_CLOUD_NAME=
CLOUDINARY_RELAY_API_KEY=
CLOUDINARY_RELAY_API_SECRET=
CLOUDINARY_RELAY_FOLDER=


# =============================================================================
# 3. Cognee knowledge graph
# =============================================================================

# LLM used for novel import / cognify / memify.
COGNEE_LLM_MODEL=DC-cognee-LLM

# Skip the Cognee startup connectivity pre-check; real requests still go through newAPI.
COGNEE_SKIP_CONNECTION_TEST=true

# Default model name used by Cognee startup and legacy paths. The model actually requested by a project is decided by its own
# project_config.json cognee_embedding_model: official legacy projects use v1,
# official new projects use v2, and CE custom newAPI projects use the unsuffixed compatible model name.
COGNEE_EMBEDDING_MODEL=DC-cognee-embedding
# Default dimension for Cognee startup and legacy paths without project context. The actual dimension of a project is decided by
# cognee_embedding_dimension in project_config.json.
COGNEE_EMBEDDING_DIM=1024

# Cap on in-flight upstream requests per novel-import pipeline. Several pipelines imported at the same time are counted separately.
# LLM entity/relation extraction and summarization share the same concurrency quota.
COGNEE_LLM_CONCURRENCY=2

# Concurrency slots for structured_v1 per-chunk extraction (character extraction, scene normalization, scene description generation).
STRUCTURED_LLM_CONCURRENCY=2
# The embedding concurrency limit currently applies only to requests sent through newAPI/custom LiteLLM; other providers log a bypass.
COGNEE_EMBEDDING_BATCH_CONCURRENCY=4

# Number of texts per Cognee embedding request. The official default is 10, compatible with Qwen / Alibaba and other models with a low input limit.
# If the upstream embedding model supports larger batches, raise it as needed.
EMBEDDING_BATCH_SIZE=10

# =============================================================================
# 4. newAPI text models
# =============================================================================

# Shot page / AI prompt optimization.
GLOBAL_VIDEO_OPTIMIZER_MODEL=DC-video-prompt-optimizer-LLM

# First/last frame / transition prompt generation.
KEYFRAME_PROMPT_MODEL=DC-video-prompt-optimizer-LLM

# Shot page / Seedance 2.0 panel / AI optimization.
SEEDANCE2_PROMPT_COMPOSER_MODEL=DC-seedance2-prompt-composer-LLM

# Sketch / AI detection of identity and prop color markers.
GLOBAL_VIDEO_IDENTITY_DETECTOR_MODEL=DC-video-identity-detector-LLM

# Episode detail / AI identity planning / on-screen character filtering.
IDENTITY_PLANNER_CAST_MODEL=DC-identity-cast-planner-LLM

# Episode detail / AI identity planning / default identity and other identity analysis.
IDENTITY_PLANNER_ANALYSIS_MODEL=DC-identity-analysis-planner-LLM

# Episode detail / AI identity planning / costume and styling description for new identities.
IDENTITY_PLANNER_APPEARANCE_MODEL=DC-identity-appearance-writer-LLM

# Episode detail / line-by-line generation.
LITERAL_BEAT_META_MODEL=DC-literal-beat-meta-LLM

# Scene library / build from graph / scene parsing, normalization and environment_prompt generation.
SCENE_BUILD_MODEL=DC-scene-builder-LLM

# Character library / build from source text / structured_v1 per-chunk character extraction and evidence citation.
CHARACTER_BUILD_MODEL=DC-character-builder-LLM

# Episode detail / scene planning.
EPISODE_SCENE_PLANNER_MODEL=DC-episode-scene-planner-LLM

# Episode detail / prop planning.
EPISODE_PROP_PLANNER_MODEL=DC-episode-prop-planner-LLM

# Freezone / Chinese-English translation of text prompts.
FREEZONE_TRANSLATION_MODEL=DC-freezone-translator-LLM

# Freezone / AI text creation.
FREEZONE_TEXT_WRITER_MODEL=DC-freezone-text-writer-LLM

# Freezone / story script generation.
FREEZONE_STORY_SCRIPT_MODEL=DC-freezone-story-script-writer-LLM

# Freezone / compile a Recipe into an executable prompt.
FREEZONE_RECIPE_COMPILER_MODEL=DC-freezone-recipe-compiler-LLM
# The Recipe compile model always has reasoning enabled; low/high/max are optional, default low.
FREEZONE_RECIPE_COMPILER_REASONING_EFFORT=low
# Per-node compile wait limit; on timeout a deterministic fallback is used and the workflow is not blocked.
FREEZONE_RECIPE_COMPILER_TIMEOUT_SECONDS=30
# Maximum concurrent compilations of Recipe prompts in the same batch (range 1-8).
FREEZONE_RECIPE_COMPILER_BATCH_CONCURRENCY=3
# Recipe text nodes may output long content such as a full script; 60 seconds are reserved for the frontend to sync the final result.
FREEZONE_RECIPE_TEXT_TIMEOUT_SECONDS=540

# Freezone / image reverse-prompting, video-reference storyboard generation and local element recognition; must support image input.
FREEZONE_VISION_MODEL=DC-freezone-vision-LLM

# Freezone canvas payload limit, in bytes.
FREEZONE_CANVAS_PAYLOAD_LIMIT_BYTES=5242880

# Canvas style gallery. The manifest ships with the package (src/novelvideo/freezone/style_templates.json),
# but the covers and sample images of the 45 styles do not ship with the repo - ASSET_BASE must point to an OSS/CDN prefix,
# and the frontend builds absolute URLs as `<base>/<relative path in the manifest>`. Left empty, the gallery shows only placeholder blocks,
# while style names/prompts/filters still work (the backend logs a WARNING the first time it serves the manifest after startup).
# The images can be built yourself with scripts/build_style_gallery.py.
# Note: the line below is a placeholder example and must not be copied as is. For a self-hosted deployment, after switching to your own domain, also add that domain
# to the img-src allowlist of the frontend CSP (frontend/docker/nginx.conf.template), otherwise the browser
# blocks all covers and it looks the same as not configuring it: a wall of placeholder blocks.
# To switch to a different style library without a new release: upload the images under a new prefix and change ASSET_BASE; store the manifest elsewhere and point to it with
# MANIFEST. The two are independent; you may change just one.
#STYLE_GALLERY_ASSET_BASE=https://cdn.example.com/style-gallery
#STYLE_GALLERY_MANIFEST=/etc/dramaclaw/style_templates.json

# Style page / create a custom style from an uploaded reference image.
STYLE_ANALYZER_MODEL=DC-style-analyzer-LLM

# Content rewriting / line-by-line text for turning source text into short-video voiceover.
CONTENT_REWRITER_MODEL=DC-content-rewriter-LLM

# Script normalization.
SCREENPLAY_NORMALIZER_MODEL=DC-screenplay-normalizer-LLM

# 2.0 asset compilation / base scene asset review.
EPISODE_SCENE_RECONCILE_MODEL=DC-episode-scene-reconciler-LLM

# 2.0 asset compilation / scene asset planning for narrated dramas.
NARRATED_SCENE_ASSET_MODEL=DC-narrated-scene-asset-planner-LLM

# DirectorWorld / Freezone AI temporary prop planning.
STAGING_PROP_MODEL=DC-staging-prop-planner-LLM
STAGING_PROP_TIMEOUT_SECONDS=120


# =============================================================================
# 5. newAPI image models
# =============================================================================

# LingShan-G2 logical model; image2-class models pass quality through per scenario.
NEWAPI_IMAGE_MODEL=LingShan-G2

# LingShan-NB-2 logical model; nano-banana/nb-class models do not pass quality through.
NEWAPI_NANOBANANA2_MODEL=LingShan-NB-2

# Default model for character images.
DEFAULT_CHARACTER_IMAGE_SELECTION=newapi_gpt_image2

# Default model for shot sketches.
DEFAULT_SKETCH_IMAGE_SELECTION=newapi_gpt_image2

# Default model for shot renders.
DEFAULT_RENDER_IMAGE_SELECTION=newapi_gpt_image2

# Project assets / prop three-view reference image reference_3view.png.
PROP_REF_IMAGE_PROVIDER=newapi
PROP_REF_IMAGE_MODEL=LingShan-G2

# Project assets / source image master.png, pure text generation.
SCENE_MASTER_IMAGE_PROVIDER=newapi
SCENE_MASTER_IMAGE_MODEL=LingShan-NB-2

# Project assets / reverse_master.png, using master.png as the reference image.
SCENE_REVERSE_MASTER_IMAGE_PROVIDER=newapi
SCENE_REVERSE_MASTER_IMAGE_MODEL=LingShan-NB-2

# Project assets / pano_360.png, using the master/reverse reference images, 2:1 panorama.
SCENE_360_IMAGE_PROVIDER=newapi
SCENE_360_IMAGE_MODEL=LingShan-G2


# =============================================================================
# 6. Image base parameters
# =============================================================================

IMAGE_DEFAULT_WIDTH=1440
IMAGE_DEFAULT_HEIGHT=2560
IMAGE_DEFAULT_STYLE=chinese_period_drama


# =============================================================================
# 7. newAPI video models
# =============================================================================

# Default video generation backend.
VIDEO_BACKEND=newapi_seedance-1.0-pro-fast

# newAPI video models selectable on the page.
NEWAPI_VIDEO_MODELS=seedance-1.0-pro-fast,seedance-1.5-pro,seedance-2.0,seedance-2.0-fast,seedance-2.0-value,seedance-2.0-fast-value,happyhorse-1.0,seedance-2.0-mini

# Default video model.
DEFAULT_VIDEO_MODEL=seedance-1.0-pro-fast
NEWAPI_VIDEO_MODEL=seedance-1.0-pro-fast

# Default video resolution.
NEWAPI_VIDEO_RESOLUTION=720p

# auto means the model and beat type decide whether to generate synchronized audio.
NEWAPI_VIDEO_GENERATE_AUDIO=auto

# Video models that support generate_audio.
NEWAPI_VIDEO_AUDIO_MODELS=seedance-1.5-pro,seedance-2.0,seedance-2.0-fast,seedance-2.0-value,seedance-2.0-fast-value,seedance-2.0-mini

# Allowed duration range of each video model, in seconds.
NEWAPI_VIDEO_DURATION_BOUNDS=seedance-1.0-pro-fast:2-12,seedance-1.5-pro:4-12,seedance-2.0:4-15,seedance-2.0-fast:4-15,seedance-2.0-value:4-15,seedance-2.0-fast-value:4-15,happyhorse-1.0:3-15,seedance-2.0-mini:4-15


# =============================================================================
# 8. newAPI audio models
# =============================================================================

# Beat audio generation uses IndexTTS2; the reference voice is passed in per the v2.0 logic.
INDEXTTS2_PROVIDER=newapi
INDEXTTS2_NEWAPI_MODEL=index-tts-2

# Audio generation HTTP timeout, in seconds.
INDEXTTS2_TIMEOUT_SECONDS=1800


# =============================================================================
# 9. Video base parameters
# =============================================================================

VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_BITRATE=4M


# =============================================================================
# 10. UI configuration
# =============================================================================


# Address of the BuilderGPT Director viewer that is reachable from the browser.
# For LAN collaboration, change it to this machine's LAN IP, for example http://192.168.2.206:9024.
DIRECTOR_VIEWER_URL=http://127.0.0.1:9024

# Operator passphrase: protects "export prompts" and the "image generation guard gate".
# You must set your own non-default value; empty = these protected actions are always refused (there is no public default passphrase).
PROMPT_EXPORT_PASSWORD=change_me

# Version/feature update notifications. false = fully disable the release feed: bundled notes are not read and GitHub is not contacted.
RELEASE_NOTIFICATIONS_ENABLED=true

# Optional GitHub token to raise the rate limit of GitHub releases/latest queries; leave empty for anonymous requests.
RELEASE_NOTIFICATIONS_GITHUB_TOKEN=

# How long a Freezone workflow run record may go without updates before it is treated as a stale run that can be resumed/interrupted, in seconds.
ST_WORKFLOW_RUN_STALE_SECONDS=60


# =============================================================================
# 11. Data directory
# =============================================================================

# output, state and runtime are all derived from NOVELVIDEO_DATA_ROOT by default.
# Locally the current directory is used by default; Docker Compose always uses the persistent volume /data.
# To migrate the whole data directory, configure an absolute path.
# NOVELVIDEO_DATA_ROOT=

# Advanced override: normally no separate configuration is needed; Docker Compose forces /data/output.
# NOVELVIDEO_OUTPUT_DIR=
# Optional BrainClaw request-transport Outcome feedback. Both values are required;
# delivery is durable and asynchronous, so model responses never wait for it.
BRAINCLAW_OUTCOME_URL=
BRAINCLAW_OUTCOME_KEY_FILE=
BRAINCLAW_OUTCOME_STATE_DIR=state/brainclaw

# Optional legacy direct-HTTP Control Context signing. This is not the normal
# Hermes -> Claymore evidence path below. All four are required together;
# leaving them empty disables only this direct transport.
# The keyring is the same owner-only JSON file the BrainClaw Gateway loads, so
# the two ends cannot drift on encoding. The grouping key must be a *separate*
# file with a longer lifetime: rotating it splits one episode into two families,
# which is what the epoch below makes visible.
BRAINCLAW_CONTROL_CONTEXT_KEYRING_FILE=
BRAINCLAW_CONTROL_CONTEXT_SIGNING_KEY_ID=
BRAINCLAW_CONTROL_CONTEXT_GROUPING_KEY_FILE=
BRAINCLAW_CONTROL_CONTEXT_GROUPING_KEY_EPOCH=1

# ---------------------------------------------------------------------------
# BrainClaw evidence plane — the issuing end.
#
# Trusted mode needs no shared signing keys. DramaClaw creates one persistent,
# local-only grouping key under STATE_DIR/brainclaw/grouping.key so raw project
# and trajectory ids never leave this process. The two K1 variables below are
# optional and used only when the selected Gateway channel is in verified mode.
# ---------------------------------------------------------------------------
BRAINCLAW_CAPABILITY_KEYRING_FILE=
BRAINCLAW_CAPABILITY_SIGNING_KEY_ID=
# The grouping path/epoch above are shared with the direct transport. When the
# path is empty, the capability issuer auto-generates it in persistent state.

# The gateway origin. Under the per-turn latch this is also the only host a
# worker may reach: a request to anything else is refused before it is sent,
# because an unauthenticated call has still carried the prompt off the machine.
NEWAPI_BASE_URL=

# Workers authenticate per turn. There is no setting for this and no way back:
# a `legacy_environment` mode existed briefly and was worse than none, because
# it restored the real key to disk while the worker kept the placeholder and
# the latch — the exposure of the old design with the behaviour of the new one.
#
# The consequence is a hard install requirement: this DramaClaw runs only with
# the Hermes fork below. A stock Hermes drops the `_meta` extension the
# credential travels in, so every turn fails closed and reports a connection
# error. DramaClaw refuses to spawn a worker rather than let that happen.

# ---------------------------------------------------------------------------
# LLM call log (dev-only): record every model call's input/output — text, image,
# audio, video, embedding — in a self-hosted Langfuse. Off unless
# LLM_CALL_LOG_ENABLED=1. Setup: docs/en/guides/llm-call-log.md
# ---------------------------------------------------------------------------
LLM_CALL_LOG_ENABLED=
# From inside the api container use http://host.docker.internal:3100 (Langfuse UI: http://localhost:3100).
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional tuning.
LLM_CALL_LOG_ENVIRONMENT=
LLM_CALL_LOG_CAPTURE_MEDIA=
LLM_CALL_LOG_MAX_MEDIA_MB=
LLM_CALL_LOG_MAX_TEXT_CHARS=
# Comma-separated extra hosts whose every request is logged (non-standard providers).
LLM_CALL_LOG_EXTRA_HOSTS=
# Only read by docker-compose.langfuse.yml / scripts/llm_call_log_cleanup.py.
LLM_LOG_RETENTION_DAYS=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_MEDIA_ENDPOINT=
LANGFUSE_PORT=
